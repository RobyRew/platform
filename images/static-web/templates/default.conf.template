# Managed by RobyRew/platform (ghcr.io/robyrew/static-web).
#
# Rendered at container start by nginx's envsubst entrypoint. Only the variables
# named in NGINX_ENVSUBST_FILTER are substituted, so nginx's own $uri, $host and
# friends survive untouched.
server {
    listen       ${WEB_PORT};
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    # The reverse proxy terminates TLS and owns the public host and port. Without
    # this nginx invents both in 30x redirects and sends visitors to :8080.
    absolute_redirect off;
    port_in_redirect  off;
    server_tokens     off;

    # add_header does NOT support `\` line continuations — they end up inside the
    # header value and the browser sees a directive named `\`, then refuses
    # everything. Build the value with `set` and concatenate.
    #
    # 'unsafe-inline' on script-src covers Astro's tiny inline bootstrap shims and
    # the no-flash theme script; on style-src it covers Astro inlining critical CSS.
    set $csp_default  "default-src 'self'";
    set $csp_script   "script-src 'self' 'unsafe-inline' ${CSP_SCRIPT_EXTRA}";
    set $csp_style    "style-src 'self' 'unsafe-inline' ${CSP_STYLE_EXTRA}";
    set $csp_img      "img-src 'self' data: blob: ${CSP_IMG_EXTRA}";
    set $csp_font     "font-src 'self' data: ${CSP_FONT_EXTRA}";
    set $csp_connect  "connect-src 'self' ${CSP_CONNECT_EXTRA}";
    set $csp_manifest "manifest-src 'self'";
    set $csp_object   "object-src 'none'";
    set $csp_frame_a  "frame-ancestors 'none'";
    set $csp_base     "base-uri 'self'";
    set $csp_form     "form-action 'self'";
    set $csp_misc     "upgrade-insecure-requests";
    set $csp "${csp_default}; ${csp_script}; ${csp_style}; ${csp_img}; ${csp_font}; ${csp_connect}; ${csp_manifest}; ${csp_object}; ${csp_frame_a}; ${csp_base}; ${csp_form}; ${csp_misc}";

    include /etc/nginx/robyrew/security-headers.conf;

    # X-XSS-Protection is deliberately absent. It is deprecated, ignored by
    # current browsers, and its filter could itself be abused to create an XSS on
    # older ones. CSP replaces it.

    gzip              on;
    gzip_vary         on;
    gzip_proxied      any;
    gzip_comp_level   6;
    gzip_min_length   256;
    gzip_types
        application/atom+xml application/javascript application/json
        application/ld+json application/manifest+json application/rss+xml
        application/vnd.ms-fontobject application/x-font-ttf
        application/xhtml+xml application/xml font/opentype
        image/bmp image/svg+xml image/x-icon text/cache-manifest
        text/css text/plain text/vcard text/vtt text/x-component;

    # Fingerprinted build output — safe to cache hard.
    location ~* ^/(_astro|assets)/.*\.(js|css|woff2|woff|ttf|svg|png|jpg|jpeg|webp|avif|gif|ico)$ {
        expires 1y;
        include /etc/nginx/robyrew/security-headers.conf;
        add_header Cache-Control "public, immutable" always;
        access_log off;
    }

    # HTML is never cached hard: a stale shell pointing at deleted hashed assets
    # is a blank page that survives a redeploy.
    location = /index.html {
        include /etc/nginx/robyrew/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    location / {
        try_files $uri $uri/ ${WEB_FALLBACK};
    }

    location = /healthz {
        access_log off;
        include /etc/nginx/robyrew/security-headers.conf;
        add_header Content-Type text/plain always;
        return 200 "ok\n";
    }
}
